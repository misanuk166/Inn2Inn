# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by the pipeline and any server route that needs to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (used by the pipeline for bulk loads via the pg driver)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Optional: a hosted OSRM endpoint for on-demand custom-segment routing in the Planner.
# Defaults to the public demo server, which is rate-limited and not suitable for production.
OSRM_URL=https://router.project-osrm.org

# Optional: MapLibre style URL. Defaults to a free demo style if unset.
NEXT_PUBLIC_MAP_STYLE_URL=
