# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by the pipeline and any server route that needs to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (used by the pipeline for bulk loads via the pg driver)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Foot-routing provider. Exactly one should be set.
#
# PREFERRED: OpenRouteService (free tier: 2000 requests/day, foot-hiking profile
# which follows trails, footways, paths). Sign up at
# https://openrouteservice.org/dev/#/signup and paste the API key here.
ORS_API_KEY=
#
# Alternative: a self-hosted OSRM instance with the FOOT profile loaded.
# DO NOT point this at router.project-osrm.org — that public demo is
# car-only and will silently answer with car routes even though the URL
# accepts "foot". See pipeline/README.md for the Docker runbook.
OSRM_URL=

# Optional: MapLibre style URL. Defaults to a free demo style if unset.
NEXT_PUBLIC_MAP_STYLE_URL=
